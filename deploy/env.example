# /opt/styk-panel/.env (chmod 600). install.sh writes it; after a change run `styk restart`.
POSTGRES_PASSWORD=          # openssl rand -hex 24
STYK_SECRET_KEY=            # openssl rand -base64 32: encrypts TOTP secrets, never rotate without re-enrolling
DOCKER_GID=                 # getent group docker | cut -d: -f3
STYK_AGENT_GID=             # getent group styk-agent | cut -d: -f3
STYK_IMAGE=ghcr.io/arturboyun/styk-panel:latest   # `styk update` pins a version here
STYK_PUBLIC_URL=            # https://panel.example.com, for links in notifications

# HTTPS. Bundled Caddy (ports 80/443): COMPOSE_PROFILES=caddy.
# Your own proxy instead: leave COMPOSE_PROFILES empty, set the network it shares with the
# panel and point the panel at its Caddyfile and container (Domains page), if it is Caddy.
COMPOSE_PROFILES=caddy
STYK_PROXY_NETWORK=styk-proxy
# STYK_CADDYFILE=/opt/styk-panel/caddy/Caddyfile
# STYK_CADDY_CONTAINER=styk-panel-caddy-1
# STYK_PROTECTED_PROJECTS=styk-panel

# Telegram Login and alerts (optional): a dedicated bot, domain set via /setdomain in @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional
# CLOUDFLARE_API_TOKEN=     # Zone.DNS:Edit, lets "New site" create the A record
# STYK_PUBLIC_IP=           # address for those records
# STYK_HEARTBEAT_URL=       # pinged every minute while the panel is healthy
